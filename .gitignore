node_modules

# Every env file EXCEPT the committed example. GEMINI_SETUP.md says to put the
# Gemini key in .env.local, which was covered; a plain .env was not, and Next.js
# loads that too, so anyone who typed the shorter name would have committed a
# live key. Ignore the whole family and allow the one file that is meant to be
# tracked, rather than listing the variants someone might pick.
.env
.env.*
!.env.example

# Build outputs
.next
dist
build
out
*.tsbuildinfo

# Dependencies
*.pnp
.pnp.js

# Testing
.nyc_output
coverage

# OS
.DS_Store
Thumbs.db

# IDE
.vscode
.idea
*.swp
*.swo
*~
.project
.classpath
*.c9/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Cached vendor datasheets for the extraction benchmark. NEVER commit datasheets.
.bench-cache
.holdout-cache

# Cached model responses for the benchmarks. Not committed because an entry is
# only valid for the exact prompt and page renders that produced it, so a shared
# copy would be stale for anyone whose tree differs by one prompt character, and
# the entries quote datasheet content back.
.model-cache

gcp-key.json
.mutation-journal.json
.bench-browser.log
.bench-browser-server.log

# One-off inspection scripts. Never part of the product.
.scratch
