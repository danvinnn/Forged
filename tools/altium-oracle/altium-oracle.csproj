<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>altium-oracle</AssemblyName>
    <RootNamespace>ForgeOracle</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CS1570;CS1573;CS1574</NoWarn>
  </PropertyGroup>
  <!-- The vendored AltiumSharp tree lives under this directory, and the SDK's
       default glob would otherwise try to compile all of it into this project. -->
  <ItemGroup>
    <Compile Remove="vendor/**" />
    <None Remove="vendor/**" />
    <EmbeddedResource Remove="vendor/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="vendor/altiumsharp/src/OriginalCircuit.Altium/OriginalCircuit.Altium.csproj" />
    <ProjectReference Include="vendor/altiumsharp/shared/OriginalCircuit.Eda.Abstractions/src/OriginalCircuit.Eda.Abstractions/OriginalCircuit.Eda.Abstractions.csproj" />
  </ItemGroup>
</Project>
