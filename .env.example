# Deployment mode gates whether Forge may touch the network at all.
#   commercial  -> network retrieval allowed (manufacturer-direct lookup, scrape fallback),
#                  and cloud extraction (Gemini) permitted as a demo-only fallback
#   air-gapped  -> upload only, zero network egress, no cloud model calls
#
# When unset or unrecognized the default is environment-aware:
#   - local dev / tests : commercial, so a fresh checkout works with no setup
#   - production build   : air-gapped, so a misconfigured prod deploy denies rather than leaks
# The consumer SaaS is a production deploy and needs network, so it MUST set this to
# commercial explicitly. A prod box that reaches the network should say so on purpose.
FORGE_DEPLOYMENT_MODE=commercial

# NOTE: there are no retrieval credentials to set. The commercial resolver chain is
#   manufacturer -> scrape
# and neither needs a key, so part-number lookup works on a fresh checkout with nothing configured.
# Component distributor APIs (Nexar, Mouser, DigiKey) were each evaluated and dropped; see
# src/lib/retrieval/LAYER1.md for the reasoning before adding one back.

# Google Gemini key for the CLOUD extraction model (Layer 2). GATED TO COMMERCIAL MODE:
# src/lib/extraction/factory.ts reaches the Gemini module only through a dynamic import inside a
# commercial-mode branch, so in air-gapped mode this key is ignored and the module is never even
# loaded. Never rely on Gemini for air-gapped extraction; use the local model below.
#
# Extraction is deterministic-first regardless of which model is configured: the text parser always
# runs, always wins, and a model is only ever asked about fields the parser could not resolve.
GOOGLE_GEMINI_API_KEY=

# LOCAL open-weight extraction model. This is the ONLY model permitted in air-gapped mode, and it
# is what makes air-gapped extraction possible at all: controlled datasheets cannot reach a cloud
# API. Point this at any OpenAI-compatible /chat/completions endpoint (vLLM, Ollama, llama.cpp,
# TGI) serving a vision-language model; the architecture names Qwen3-VL as the candidate.
#
# The endpoint MUST resolve to a private or loopback address. A public one is refused at runtime,
# because a misconfigured "local" model pointing at a cloud host would send controlled datasheet
# text off the customer network, which is the single thing air-gapped mode exists to prevent.
# Example: http://127.0.0.1:8000/v1/chat/completions
FORGE_LOCAL_MODEL_URL=
FORGE_LOCAL_MODEL_NAME=qwen3-vl

# Wall-clock ceiling for PDF text extraction, in milliseconds. Default 20000.
# Layer 1 checks the %PDF magic bytes and the file size but never opens the document, so this is the
# first point at which a small file that expands catastrophically becomes a denial-of-service
# vector. Alongside this budget the parser caps pages (400), extracted characters (5,000,000), and
# text objects per page (100,000); a breach returns 422 PARSE_LIMIT_EXCEEDED rather than hanging.
# This MUST sit under the route's maxDuration (30s) or the platform kills the request first and the
# user gets a 504 instead of a clean error.
FORGE_PARSE_BUDGET_MS=20000

# Structured logging. Events go to stdout as one JSON object per line, which every host ingests, so
# there is no vendor SDK and nothing to configure in an air-gapped deploy.
# Levels: debug | info | warn | error. Default info.
FORGE_LOG_LEVEL=info

# Whether part numbers appear in logs. Leave UNSET to get the mode-dependent default, which is
# what you almost certainly want:
#   commercial  -> ON.  Parts are public, we run the service, and a log with no part number cannot
#                       diagnose anything.
#   air-gapped  -> OFF. Any single part number is public, but the SET of parts a defense customer
#                       researches reveals program composition. Aggregation is the risk, and these
#                       are the customers who bought this product for its disclosure guarantees.
# Setting it explicitly overrides the default in either direction.
# Datasheet text, PDF bytes, prompts, request bodies, and any key/token/secret field are NEVER
# logged regardless of this setting.
# FORGE_LOG_PART_NUMBERS=

# Wall-clock ceiling for the whole resolver chain, in milliseconds. Default 12000.
# This MUST sit under your host's function timeout. If the platform kills the request first the user
# gets a 504 instead of a clean DATASHEET_NOT_FOUND, which throws away the graceful degradation the
# chain is built around. Many serverless defaults are 10 to 15 seconds; raise this only on a host
# that allows longer requests.
FORGE_CHAIN_BUDGET_MS=12000

# OPTIONAL paid search backend. Leave blank and Forge uses the free scraped backends
# (DuckDuckGo HTML, DuckDuckGo Lite, Mojeek) with automatic failover and a circuit breaker.
#
# Context as of mid-2026: the free search API market is gone. Brave retired its free tier in
# February 2026 (metered, card required, no spending cap, attribution mandatory in your UI),
# Microsoft shut down the Bing Search API, and Google's Custom Search JSON API is discontinued with
# a January 2027 end date. So this is wired but inert: setting a key is how you buy reliability if
# scraped backends degrade in production, without a code change.
#
# If you enable this, you MUST display Brave attribution in the UI. That is a term of their plans.
BRAVE_SEARCH_API_KEY=
