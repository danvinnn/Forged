# Deployment mode gates whether Forge may touch the network at all.
#   commercial  -> network retrieval allowed (manufacturer-direct lookup, scrape fallback),
#                  and cloud extraction (Gemini) permitted as a demo-only fallback
#   air-gapped  -> upload only, zero network egress, no cloud model calls
#
# When unset or unrecognized the default is environment-aware:
#   - local dev / tests : commercial, so a fresh checkout works with no setup
#   - production build   : air-gapped, so a misconfigured prod deploy denies rather than leaks
# The consumer SaaS is a production deploy and needs network, so it MUST set this to
# commercial explicitly. A prod box that reaches the network should say so on purpose.
FORGE_DEPLOYMENT_MODE=commercial

# NOTE: there are no retrieval credentials to set. The commercial resolver chain is
#   manufacturer -> scrape
# and neither needs a key, so part-number lookup works on a fresh checkout with nothing configured.
# Component distributor APIs (Nexar, Mouser, DigiKey) were each evaluated and dropped; see
# src/lib/retrieval/LAYER1.md for the reasoning before adding one back.

# Google Gemini key for the cloud extraction path (Layer 2, demo only). GATED TO COMMERCIAL MODE:
# the routes reach Gemini only through a dynamic import inside a commercial-mode branch, so in
# air-gapped mode this key is ignored and the deterministic parser is used. Never rely on Gemini
# for air-gapped extraction; that path must be a locally hostable open-weight model.
GOOGLE_GEMINI_API_KEY=

# Wall-clock ceiling for the whole resolver chain, in milliseconds. Default 12000.
# This MUST sit under your host's function timeout. If the platform kills the request first the user
# gets a 504 instead of a clean DATASHEET_NOT_FOUND, which throws away the graceful degradation the
# chain is built around. Many serverless defaults are 10 to 15 seconds; raise this only on a host
# that allows longer requests.
FORGE_CHAIN_BUDGET_MS=12000

# OPTIONAL paid search backend. Leave blank and Forge uses the free scraped backends
# (DuckDuckGo HTML, DuckDuckGo Lite, Mojeek) with automatic failover and a circuit breaker.
#
# Context as of mid-2026: the free search API market is gone. Brave retired its free tier in
# February 2026 (metered, card required, no spending cap, attribution mandatory in your UI),
# Microsoft shut down the Bing Search API, and Google's Custom Search JSON API is discontinued with
# a January 2027 end date. So this is wired but inert: setting a key is how you buy reliability if
# scraped backends degrade in production, without a code change.
#
# If you enable this, you MUST display Brave attribution in the UI. That is a term of their plans.
BRAVE_SEARCH_API_KEY=
